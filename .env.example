# ── Runtime ───────────────────────────────────────────────────────────────────

# Path to the mailbox_server.proto file
PROTO_PATH=./protos/mailbox_server.proto

# SQLite file for checkpoints and device registrations
CHECKPOINT_DB=./relay.db

# Delay in ms before reconnecting after a stream error or disconnect
SUBSCRIBE_RETRY_MS=3000

# HTTP port for /healthz, /metrics, and /v1/* endpoints
METRICS_PORT=9898

# Set to 1 to process messages without actually sending APNs notifications
DRY_RUN=0

# ── APNs credentials ──────────────────────────────────────────────────────────
APNS_KEY_FILE=./keys/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.example.yourapp

# Set to 1 for production app builds; 0 for development/sandbox builds
APNS_PRODUCTION=1

# Set to 1 to retry once against the opposite APNs environment on
# BadDeviceToken/Unregistered (useful while supporting both Debug and TestFlight)
APNS_ALLOW_BOTH_ENVIRONMENTS=0

# Optional: dedicated credentials for the fallback APNs environment.
# Set all three together or leave all three empty.
# APNS_FALLBACK_KEY_FILE=./keys/apns-fallback.p8
# APNS_FALLBACK_KEY_ID=
# APNS_FALLBACK_TEAM_ID=

APNS_PUSH_TYPE=alert

# ── HTTP API ──────────────────────────────────────────────────────────────────

# API token required on all /v1/* endpoints
# Generate with: openssl rand -hex 32
RELAY_API_TOKEN=

# Rate limiting for /v1/* endpoints (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Set to 1 if running behind a reverse proxy (nginx, etc.)
TRUST_PROXY=0

# ── Event log + admin API ─────────────────────────────────────────────────────

# SQLite file for the event log (separate from CHECKPOINT_DB; safe to delete).
# Defaults to relay-events.db next to CHECKPOINT_DB.
# EVENTS_DB=./relay-events.db

# Days to keep individual event rows. Hourly rollup counts are kept forever.
EVENT_RETENTION_DAYS=30

# Hard cap on event rows (oldest dropped first), as a safety net against floods
EVENT_MAX_ROWS=2000000

# Bearer token for the read-only /insights/v1/* endpoints. Leave empty to disable
# them entirely. Must NOT be the same as RELAY_API_TOKEN (which ships in the app).
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Browser origins allowed to read /insights/v1/* (comma-separated, exact match).
# The special value "localhost" allows http://localhost and 127.0.0.1 on any port.
ADMIN_CORS_ORIGIN=localhost

# Max /insights/v1/* requests per IP per minute
ADMIN_RATE_LIMIT_MAX=300

# ── Authorization wake-up pushes ──────────────────────────────────────────────

# Send a silent push asking the app to renew a mailbox authorization that is
# about to expire or has expired. Schedule per token: AUTH_WAKE_LEAD_MS before
# expiry, again at half that, then 1h after expiry and daily after that.
AUTH_WAKE_ENABLED=1

# How long before expiry the first wake is sent (default 2h)
AUTH_WAKE_LEAD_MS=7200000

# How many wakes to send after expiry (one a day) before giving up
AUTH_WAKE_POST_EXPIRY_ATTEMPTS=7

# Max wakes sent per scheduler pass (one pass a minute); spreads out a backlog
AUTH_WAKE_MAX_PER_TICK=5
